{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-run-context-v1",
  "title": "CodeStructureViz canonical Next run context v1",
  "description": "One explicit context shared by response, gate, domain, root manifest, and stdout projections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requested_formats", "budget_requested", "budget_resolved", "budget_source", "stdout_selector"],
  "properties": {
    "requested_formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["semantic-json", "plantuml"]}
    },
    "budget_requested": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 100000},
        {"type": "null"}
      ]
    },
    "budget_resolved": {"type": "integer", "minimum": 1, "maximum": 100000},
    "budget_source": {"enum": ["builtin", "repository", "explicit", "cli"]},
    "stdout_selector": {"enum": ["next:semantic-json", "next:plantuml"]}
  }
}
