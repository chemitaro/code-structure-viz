{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-run-context-v1",
  "title": "CodeStructureViz canonical Next run context v1",
  "description": "One explicit context shared by response, gate, domain, root manifest, and stdout projections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requested_formats", "budget_requested", "budget_resolved", "budget_source", "stdout_selector"],
  "properties": {
    "requested_formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["semantic-json", "plantuml"]}
    },
    "budget_requested": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 100000},
        {"type": "null"}
      ]
    },
    "budget_resolved": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 100000},
        {"type": "null"}
      ]
    },
    "budget_source": {"enum": ["builtin", "repository", "explicit", "cli", "unobserved"]},
    "stdout_selector": {"enum": [null, "manifest", "next:semantic-json", "next:plantuml"]}
  },
  "allOf": [
    {
      "if": {"properties": {"budget_source": {"const": "unobserved"}}},
      "then": {
        "properties": {
          "budget_requested": {"const": null},
          "budget_resolved": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"budget_source": {"const": "builtin"}}},
      "then": {
        "properties": {
          "budget_requested": {"const": null},
          "budget_resolved": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"budget_source": {"enum": ["repository", "explicit", "cli"]}}
      },
      "then": {
        "properties": {
          "budget_requested": {"type": "integer", "minimum": 1},
          "budget_resolved": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {"properties": {"stdout_selector": {"const": "next:semantic-json"}}},
      "then": {"properties": {"requested_formats": {"contains": {"const": "semantic-json"}}}}
    },
    {
      "if": {"properties": {"stdout_selector": {"const": "next:plantuml"}}},
      "then": {"properties": {"requested_formats": {"contains": {"const": "plantuml"}}}}
    }
  ]
}
