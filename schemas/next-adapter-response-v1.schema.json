{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-adapter-response-v1",
  "title": "CodeStructureViz Next adapter response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol", "request_id", "adapter_version", "trusted_type_environment_digest", "semantic_compatibility_id", "compatibility_descriptor", "identity_versions", "limits", "model", "proof", "model_digest"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-adapter-response/v1"},
    "protocol": {"const": "code-structure-viz.next-adapter/v1"},
    "request_id": {"$ref": "#/$defs/digest"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trusted_type_environment_digest": {"$ref": "#/$defs/digest"},
    "semantic_compatibility_id": {"$ref": "#/$defs/digest"},
    "compatibility_descriptor": {"$ref": "urn:code-structure-viz:schema:next-compatibility-v1"},
    "identity_versions": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/identity_versions"},
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"},
    "model": {"$ref": "#/$defs/model"},
    "proof": {"$ref": "#/$defs/proof"},
    "model_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collection": {"enum": ["projects", "files", "modules", "components", "members", "relations", "facts"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "projects", "files", "modules", "components", "members", "relations", "facts", "coverage", "diagnostics"],
      "properties": {
        "schema": {"const": "code-structure-viz.next-model/v1"},
        "projects": {"type": "array", "maxItems": 1000, "items": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/project"}},
        "files": {"type": "array", "maxItems": 20000, "items": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/file"}},
        "modules": {"type": "array", "maxItems": 20000, "items": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module"}},
        "components": {"type": "array", "maxItems": 20000, "items": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/component"}},
        "members": {"type": "array", "maxItems": 20000, "items": {"oneOf": [{"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/export_member"}, {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/import_member"}, {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/prop_member"}]}},
        "relations": {"type": "array", "maxItems": 20000, "items": {"oneOf": [{"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module_relation"}, {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/render_relation"}, {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/wrap_relation"}]}},
        "facts": {"type": "array", "maxItems": 20000, "items": {"oneOf": [{"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/client_fact"}, {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/router_fact"}]}},
        "coverage": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/coverage"},
        "diagnostics": {"type": "array", "items": {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/diagnostic"}}
      }
    },
    "record": {"oneOf": [
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/project"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/file"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/component"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/export_member"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/import_member"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/prop_member"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module_relation"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/render_relation"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/wrap_relation"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/client_fact"},
      {"$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/router_fact"}
    ]},
    "proof_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "record", "taints"],
      "properties": {
        "collection": {"$ref": "#/$defs/collection"},
        "record": {"$ref": "#/$defs/record"},
        "taints": {"type": "array", "uniqueItems": true, "items": {"enum": ["parse_file", "read_file", "type_symbol", "export_binding", "props_subtree", "component_flow", "module_relation", "boundary_derivation"]}}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered_records", "failure_roots", "causal_edges", "target_resolutions", "export_resolution_witness", "excluded", "failed"],
      "properties": {
        "discovered_records": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/proof_record"}},
        "failure_roots": {"type": "array", "items": {"$ref": "#/$defs/failure_root"}},
        "causal_edges": {"type": "array", "items": {"$ref": "#/$defs/causal_edge"}},
        "target_resolutions": {"type": "array", "items": {"$ref": "#/$defs/target_resolution"}},
        "export_resolution_witness": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/export_resolution_witness"}},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/excluded_record"}},
        "failed": {"type": "array", "items": {"$ref": "#/$defs/failed_record"}}
      }
    },
    "failure_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "collection", "kind", "path_ref", "record_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^next:failure:[0-9a-f]{64}$"},
        "collection": {"$ref": "#/$defs/collection"},
        "kind": {"enum": ["parse_file", "read_file", "type_symbol", "export_binding", "props_subtree", "component_flow", "module_relation", "boundary_derivation"]},
        "path_ref": {"anyOf": [{"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, {"type": "null"}]},
        "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^next:(project|file|module|component|member|relation|fact):[0-9a-f]{64}$"}}
      }
    },
    "causal_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "record_id", "rule"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^next:(failure|project|file|module|component|member|relation|fact):[0-9a-f]{64}$"},
        "record_id": {"type": "string", "pattern": "^next:(project|file|module|component|member|relation|fact):[0-9a-f]{64}$"},
        "rule": {"enum": ["file_all_records", "incoming_reexport", "value_import_dependency", "component_flow", "boundary_closure", "type_subtree", "identity_dependency", "relation_dependency"]}
      }
    },
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_key", "status", "record_ids"],
      "properties": {"target_key": {"$ref": "urn:code-structure-viz:schema:next-config-v1#/$defs/target_key"}, "status": {"enum": ["resolved", "failed"]}, "record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^next:(project|file|module|component|member|relation|fact):[0-9a-f]{64}$"}}}
    },
    "export_resolution_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "resolution", "component_id"],
      "properties": {
        "member_id": {"type": "string", "pattern": "^next:member:[0-9a-f]{64}$"},
        "resolution": {"enum": ["component", "value", "type"]},
        "component_id": {"anyOf": [{"type": "string", "pattern": "^next:component:[0-9a-f]{64}$"}, {"type": "null"}]}
      }
    },
    "excluded_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "record_id", "reason"],
      "properties": {"collection": {"$ref": "#/$defs/collection"}, "record_id": {"type": "string", "pattern": "^next:(project|file|module|component|member|relation|fact):[0-9a-f]{64}$"}, "reason": {"enum": ["tainted", "target_excluded", "unsupported", "failed", "not_selected", "over_budget"]}}
    },
    "failed_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "record_id", "reason"],
      "properties": {
        "collection": {"$ref": "#/$defs/collection"},
        "record_id": {"type": "string", "pattern": "^next:(project|file|module|component|member|relation|fact):[0-9a-f]{64}$"},
        "reason": {"enum": ["parse_file", "read_file", "type_symbol", "export_binding", "props_subtree", "component_flow", "module_relation", "boundary_derivation", "over_budget"]}
      }
    }
  }
}
