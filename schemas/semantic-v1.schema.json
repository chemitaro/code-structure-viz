{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeStructureViz Python semantic snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "domain",
    "document_kind",
    "status",
    "diagnostics"
  ],
  "properties": {
    "type": {"enum": ["semantic_snapshot", "semantic_diff"]},
    "schema": {"const": "code-structure-viz.semantic/v1"},
    "domain": {"const": "python"},
    "document_kind": {"enum": ["snapshot", "diff"]},
    "status": {"enum": ["complete", "incomplete", "not_applicable"]},
    "incomplete_kind": {"const": "partial_safe"},
    "source": {"$ref": "#/$defs/source"},
    "request": {"$ref": "#/$defs/request"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "before": {"$ref": "#/$defs/diff_side"},
    "after": {"$ref": "#/$defs/diff_side"},
    "before_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_change_set": {"$ref": "#/$defs/file_change_set"},
    "semantic_change_set": {"$ref": "#/$defs/semantic_change_set"},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "semantic_snapshot"},
        "document_kind": {"const": "snapshot"},
        "status": {"const": "complete"}
      },
      "required": ["source", "request", "coverage", "entities", "members", "relations"],
      "not": {"required": ["incomplete_kind"]}
    },
    {
      "properties": {
        "type": {"const": "semantic_snapshot"},
        "document_kind": {"const": "snapshot"},
        "status": {"const": "incomplete"},
        "incomplete_kind": {"const": "partial_safe"}
      },
      "required": [
        "source",
        "request",
        "coverage",
        "entities",
        "members",
        "relations",
        "incomplete_kind"
      ]
    },
    {
      "properties": {
        "type": {"const": "semantic_diff"},
        "document_kind": {"const": "diff"},
        "status": {"enum": ["complete", "not_applicable"]}
      },
      "required": [
        "before",
        "after",
        "before_snapshot_sha256",
        "after_snapshot_sha256",
        "file_change_set",
        "semantic_change_set"
      ],
      "not": {"required": ["incomplete_kind"]}
    },
    {
      "properties": {
        "type": {"const": "semantic_diff"},
        "document_kind": {"const": "diff"},
        "status": {"const": "incomplete"},
        "incomplete_kind": {"const": "partial_safe"}
      },
      "required": [
        "before",
        "after",
        "before_snapshot_sha256",
        "after_snapshot_sha256",
        "file_change_set",
        "semantic_change_set",
        "incomplete_kind"
      ]
    }
  ],
  "$defs": {
    "diff_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain", "schema", "digest", "head_commit", "file_count"],
      "properties": {
        "kind": {"enum": ["real", "canonical-empty-side", "analysis-failed"]},
        "domain": {"const": "python"},
        "schema": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "head_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "file_count": {"type": "integer", "minimum": 0}
      }
    },
    "diff_id": {
      "type": "string",
      "pattern": "^python:(?:class|member|relation):"
    },
    "semantic_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id", "before", "after"],
      "properties": {
        "status": {"enum": ["added", "removed", "modified", "moved", "unknown"]},
        "id": {"$ref": "#/$defs/diff_id"},
        "before": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "after": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "matching_evidence": {"$ref": "#/$defs/matching_evidence"}
      }
    },
    "matching_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_id", "after_id", "reason", "fingerprint"],
      "properties": {
        "before_id": {"$ref": "#/$defs/diff_id"},
        "after_id": {"$ref": "#/$defs/diff_id"},
        "reason": {"const": "unique-structural-fingerprint"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "downstream"],
      "properties": {
        "upstream": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "downstream": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "semantic_change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "members", "relations", "seeds", "impact", "matching"],
      "properties": {
        "entities": {"type": "array", "items": {"$ref": "#/$defs/semantic_delta"}},
        "members": {"type": "array", "items": {"$ref": "#/$defs/semantic_delta"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/semantic_delta"}},
        "seeds": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "impact": {"$ref": "#/$defs/impact"},
        "matching": {"type": "array", "items": {"$ref": "#/$defs/matching_evidence"}}
      }
    },
    "file_change_hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_start",
        "old_line_count",
        "new_start",
        "new_line_count",
        "ordinal",
        "hunk_id"
      ],
      "properties": {
        "old_start": {"type": "integer", "minimum": 0},
        "old_line_count": {"type": "integer", "minimum": 0},
        "new_start": {"type": "integer", "minimum": 0},
        "new_line_count": {"type": "integer", "minimum": 0},
        "ordinal": {"type": "integer", "minimum": 0},
        "hunk_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "file_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "old_path", "new_path", "hunks"],
      "properties": {
        "status": {"enum": ["A", "M", "D", "R", "C", "T", "U", "?"]},
        "old_path": {"type": ["string", "null"]},
        "new_path": {"type": ["string", "null"]},
        "hunks": {"type": "array", "items": {"$ref": "#/$defs/file_change_hunk"}}
      }
    },
    "file_change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "before", "after", "files"],
      "properties": {
        "schema": {"const": "code-structure-viz.file-change-set/v1"},
        "before": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "after": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "files": {"type": "array", "items": {"$ref": "#/$defs/file_change"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "head_commit", "fingerprint", "file_count"],
      "properties": {
        "schema": {"const": "code-structure-viz.source-view/v1"},
        "kind": {"const": "working-tree"},
        "head_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 0}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["path", "module", "class"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "upstream_depth", "downstream_depth"],
      "properties": {
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "upstream_depth": {"type": "integer", "minimum": 0},
        "downstream_depth": {"type": "integer", "minimum": 0}
      }
    },
    "failed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "stage", "diagnostic_code"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "stage": {
          "enum": [
            "read",
            "path_safety",
            "encoding",
            "parse",
            "module_identity",
            "module_collision"
          ]
        },
        "diagnostic_code": {
          "enum": [
            "CSV-SOURCE-002",
            "CSV-SOURCE-004",
            "CSV-PY-001",
            "CSV-PY-002",
            "CSV-PY-003",
            "CSV-PY-004",
            "CSV-PY-005"
          ]
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "kind", "reference", "reason"],
      "properties": {
        "direction": {"enum": ["upstream", "downstream", "failure"]},
        "kind": {"enum": ["module", "class", "symbol", "file"]},
        "reference": {"type": "string", "minLength": 1},
        "reason": {
          "enum": [
            "depth_limit",
            "unresolved_reference",
            "failed_source",
            "unsupported_scope",
            "star_import",
            "identity_collision"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_files",
        "parsed_files",
        "failed_files",
        "selected_modules",
        "selected_entities",
        "frontier"
      ],
      "properties": {
        "candidate_files": {"type": "integer", "minimum": 0},
        "parsed_files": {"type": "integer", "minimum": 0},
        "failed_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/failed_file"}
        },
        "selected_modules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "selected_entities": {"type": "integer", "minimum": 0},
        "frontier": {"type": "array", "items": {"$ref": "#/$defs/frontier"}}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "decorator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "called"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "called": {"type": "boolean"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "module",
        "qualified_name",
        "name",
        "path",
        "range",
        "decorators"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^python:class:"},
        "kind": {"const": "class"},
        "module": {"type": "string", "minLength": 1},
        "qualified_name": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/range"},
        "decorators": {"type": "array", "items": {"$ref": "#/$defs/decorator"}}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "annotation", "has_default"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "positional_only",
            "positional_or_keyword",
            "var_positional",
            "keyword_only",
            "var_keyword"
          ]
        },
        "annotation": {"type": ["string", "null"]},
        "has_default": {"type": "boolean"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["async", "parameters", "returns"],
      "properties": {
        "async": {"type": "boolean"},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "returns": {"type": ["string", "null"]}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_id",
        "kind",
        "name",
        "scope",
        "property_role",
        "method_kind",
        "annotation",
        "signature",
        "decorators",
        "range"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^python:member:[0-9a-f]{64}$"},
        "owner_id": {"type": "string", "pattern": "^python:class:"},
        "kind": {"enum": ["field", "property", "method"]},
        "name": {"type": "string", "minLength": 1},
        "scope": {"enum": ["class", "instance", null]},
        "property_role": {"enum": ["getter", "setter", "deleter", null]},
        "method_kind": {"enum": ["instance", "class", "static", null]},
        "annotation": {"type": ["string", "null"]},
        "signature": {
          "oneOf": [{"$ref": "#/$defs/signature"}, {"type": "null"}]
        },
        "decorators": {"type": "array", "items": {"$ref": "#/$defs/decorator"}},
        "range": {"$ref": "#/$defs/range"}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "field"},
            "scope": {"enum": ["class", "instance"]},
            "property_role": {"type": "null"},
            "method_kind": {"type": "null"},
            "signature": {"type": "null"}
          }
        },
        {
          "properties": {
            "kind": {"const": "property"},
            "scope": {"type": "null"},
            "property_role": {"enum": ["getter", "setter", "deleter"]},
            "method_kind": {"type": "null"},
            "signature": {"$ref": "#/$defs/signature"}
          },
          "oneOf": [
            {
              "properties": {
                "property_role": {"enum": ["getter", "setter"]},
                "annotation": {"type": ["string", "null"]}
              }
            },
            {
              "properties": {
                "property_role": {"const": "deleter"},
                "annotation": {"type": "null"}
              }
            }
          ]
        },
        {
          "properties": {
            "kind": {"const": "method"},
            "scope": {"type": "null"},
            "property_role": {"type": "null"},
            "method_kind": {"enum": ["instance", "class", "static"]},
            "annotation": {"type": "null"},
            "signature": {"$ref": "#/$defs/signature"}
          }
        }
      ]
    },
    "relation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "kind", "id", "name"],
      "properties": {
        "resolution": {"enum": ["internal", "external", "unknown"]},
        "kind": {"enum": ["class", "module", "symbol"]},
        "id": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {
            "resolution": {"const": "internal"},
            "kind": {"const": "class"},
            "id": {"type": "string", "pattern": "^python:class:"}
          }
        },
        {
          "properties": {
            "resolution": {"const": "internal"},
            "kind": {"const": "module"},
            "id": {"type": "string", "pattern": "^python:module:"}
          }
        },
        {
          "properties": {
            "resolution": {"const": "external"},
            "kind": {"enum": ["module", "symbol"]},
            "id": {"type": "null"}
          }
        },
        {
          "properties": {
            "resolution": {"const": "unknown"},
            "kind": {"const": "symbol"},
            "id": {"type": "null"}
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_id",
        "target",
        "via_member_id",
        "annotation",
        "range"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^python:relation:[0-9a-f]{64}$"},
        "kind": {
          "enum": ["inheritance", "composition", "typed_dependency", "import_dependency"]
        },
        "source_id": {"type": "string", "pattern": "^python:(?:class|module):"},
        "target": {"$ref": "#/$defs/relation_target"},
        "via_member_id": {"type": ["string", "null"]},
        "annotation": {"type": ["string", "null"]},
        "range": {"$ref": "#/$defs/range"}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "inheritance"},
            "source_id": {"type": "string", "pattern": "^python:class:"},
            "via_member_id": {"type": "null"},
            "annotation": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "kind": {"enum": ["composition", "typed_dependency"]},
            "source_id": {"type": "string", "pattern": "^python:class:"},
            "via_member_id": {
              "type": "string",
              "pattern": "^python:member:[0-9a-f]{64}$"
            },
            "annotation": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "kind": {"const": "import_dependency"},
            "source_id": {"type": "string", "pattern": "^python:module:"},
            "target": {
              "allOf": [
                {"$ref": "#/$defs/relation_target"},
                {"properties": {"kind": {"const": "module"}}}
              ]
            },
            "via_member_id": {"type": "null"},
            "annotation": {"type": "null"}
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema",
        "code",
        "severity",
        "domain",
        "path",
        "symbol",
        "line",
        "recoverable",
        "message"
      ],
      "properties": {
        "type": {"const": "diagnostic"},
        "schema": {"const": "code-structure-viz.diagnostic/v1"},
        "code": {
          "enum": [
            "CSV-USAGE-001",
            "CSV-USAGE-002",
            "CSV-USAGE-003",
            "CSV-USAGE-004",
            "CSV-USAGE-005",
            "CSV-CONFIG-001",
            "CSV-CONFIG-002",
            "CSV-CONFIG-003",
            "CSV-CONFIG-004",
            "CSV-ENV-001",
            "CSV-ENV-002",
            "CSV-REPO-001",
            "CSV-REPO-002",
            "CSV-OUTPUT-001",
            "CSV-OUTPUT-002",
            "CSV-SOURCE-001",
            "CSV-SOURCE-002",
            "CSV-SOURCE-003",
            "CSV-SOURCE-004",
            "CSV-PY-001",
            "CSV-PY-002",
            "CSV-PY-003",
            "CSV-PY-004",
            "CSV-PY-005",
            "CSV-PY-006",
            "CSV-PY-007",
            "CSV-PY-008",
            "CSV-PY-009",
            "CSV-PY-010",
            "CSV-PY-011",
            "CSV-PY-012",
            "CSV-PY-013",
            "CSV-INTERNAL-001",
            "CSV-INTERRUPT-001"
          ]
        },
        "severity": {"enum": ["error", "warning", "info"]},
        "domain": {"enum": ["python", null]},
        "path": {"type": ["string", "null"]},
        "symbol": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "recoverable": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1}
      },
      "allOf": [{"$ref": "urn:code-structure-viz:schema:diagnostic-v1"}]
    }
  }
}
