{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-execution-assets-v1",
  "title": "CodeStructureViz retained Next execution asset content identity v1",
  "description": "Portable content identity, not a build inventory, runtime availability claim, or image attestation. Cross-member ordering, entrypoint membership and digest require the byte owner's validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entrypoint_member", "members", "asset_set_id"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-execution-assets/v1"},
    "entrypoint_member": {"const": "code_structure_viz/_next_runtime/next-adapter.mjs"},
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"}
    },
    "asset_set_id": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "role", "size_bytes", "sha256"],
      "properties": {
        "package_path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^code_structure_viz/_next_runtime/(?!(?:[a-z0-9._-]+/)*\\.{1,2}(?:/|$))(?:[a-z0-9._-]+/)*[a-z0-9._-]+(?![\\s\\S])"
        },
        "role": {"enum": ["adapter", "typescript_lib", "trusted_declaration"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
