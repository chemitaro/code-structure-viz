{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeStructureViz diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "code",
    "severity",
    "domain",
    "path",
    "symbol",
    "line",
    "recoverable",
    "message"
  ],
  "properties": {
    "type": {"const": "diagnostic"},
    "schema": {"const": "code-structure-viz.diagnostic/v1"},
    "code": {
      "enum": [
        "CSV-USAGE-001",
        "CSV-USAGE-002",
        "CSV-USAGE-003",
        "CSV-USAGE-004",
        "CSV-USAGE-005",
        "CSV-CONFIG-001",
        "CSV-CONFIG-002",
        "CSV-CONFIG-003",
        "CSV-CONFIG-004",
        "CSV-ENV-001",
        "CSV-ENV-002",
        "CSV-REPO-001",
        "CSV-REPO-002",
        "CSV-OUTPUT-001",
        "CSV-OUTPUT-002",
        "CSV-SOURCE-001",
        "CSV-SOURCE-002",
        "CSV-SOURCE-003",
        "CSV-SOURCE-004",
        "CSV-PY-001",
        "CSV-PY-002",
        "CSV-PY-003",
        "CSV-PY-004",
        "CSV-PY-005",
        "CSV-PY-006",
        "CSV-PY-007",
        "CSV-PY-008",
        "CSV-PY-009",
        "CSV-PY-010",
        "CSV-PY-011",
        "CSV-PY-012",
        "CSV-PY-013",
        "CSV-INTERNAL-001",
        "CSV-INTERRUPT-001"
      ]
    },
    "severity": {"enum": ["error", "warning", "info"]},
    "domain": {"type": ["string", "null"], "enum": ["python", null]},
    "path": {"type": ["string", "null"], "minLength": 1},
    "symbol": {"type": ["string", "null"], "minLength": 1},
    "line": {"type": ["integer", "null"], "minimum": 1},
    "recoverable": {"type": "boolean"},
    "message": {"type": "string", "minLength": 1}
  }
}
