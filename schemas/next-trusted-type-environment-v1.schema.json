{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-trusted-type-environment-v1",
  "title": "CodeStructureViz Next trusted type environment manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment_version", "semantic_profile_id", "typescript_version", "license_inventory_digest", "files", "reserved_module_specifiers", "reserved_global_names", "certified_symbols", "sha256"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-trusted-types/v1"},
    "environment_version": {"type": "string", "minLength": 1},
    "semantic_profile_id": {"type": "string", "pattern": "^next-trusted-profile-v[0-9]+$"},
    "typescript_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "license_inventory_digest": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "reserved_module_specifiers": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["react", "react/jsx-runtime", "react/jsx-dev-runtime", "next/dynamic"]}},
    "reserved_global_names": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["Array", "JSX", "ReadonlyArray"]}},
    "certified_symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["virtual_path", "sha256", "license_id"],
      "properties": {"virtual_path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)/\\.code-structure-viz/trusted/v1/[A-Za-z0-9._/-]+\\.d\\.ts$"}, "sha256": {"$ref": "#/$defs/digest"}, "license_id": {"type": "string", "minLength": 1}}
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_name", "export_path", "declaration_sha256", "symbol_kind", "signature_digest"],
      "properties": {
        "source_kind": {"enum": ["module", "global"]}, "source_name": {"type": "string", "minLength": 1},
        "export_path": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}},
        "declaration_sha256": {"$ref": "#/$defs/digest"},
        "symbol_kind": {"enum": ["function", "class", "interface", "namespace", "method", "type"]},
        "signature_digest": {"$ref": "#/$defs/digest"}
      },
      "oneOf": [
        {"properties": {"source_kind": {"const": "module"}, "source_name": {"enum": ["react", "react/jsx-runtime", "react/jsx-dev-runtime", "next/dynamic"]}}},
        {"properties": {"source_kind": {"const": "global"}, "source_name": {"enum": ["Array", "JSX", "ReadonlyArray"]}}}
      ]
    }
  }
}
