{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-source-plan-v1",
  "title": "CodeStructureViz closed Next SourceAcquisitionPlan v1",
  "description": "A sealed plan may carry the source-plan-owned redacted resolved/open graph. The graph is never caller-supplied authority and unsafe raw specifiers are not serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "projects",
    "resolved_control_paths",
    "local_extends",
    "file_role_map",
    "program_suffixes",
    "context_suffixes",
    "hard_exclusions",
    "limits",
    "trusted_environment_digest",
    "config_resolution",
    "source_graph"
  ],
  "properties": {
    "schema": {"const": "code-structure-viz.source-acquisition-plan/next/v1"},
    "version": {"const": "1"},
    "projects": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/project"}},
    "resolved_control_paths": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/control_path"}},
    "local_extends": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/local_extend"}},
    "file_role_map": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/file_role"}},
    "program_suffixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
    "context_suffixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9.]+$"}},
    "hard_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f]).+$"}},
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"},
    "trusted_environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_resolution": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/config_resolution"}},
    "source_graph": {"$ref": "#/$defs/source_graph"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"$ref": "urn:code-structure-viz:schema:next-path-v1"},
    "root_path": {"$ref": "urn:code-structure-viz:schema:next-root-or-path-v1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "source_roots", "config_path", "compiler_options"],
      "properties": {
        "root": {"$ref": "#/$defs/root_path"},
        "source_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:code-structure-viz:schema:next-root-or-path-v1"}},
        "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "compiler_options": {
          "$ref": "urn:code-structure-viz:schema:next-config-v1#/$defs/compiler_options"
        }
      }
    },
    "control_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "path"],
      "properties": {"project_root": {"$ref": "#/$defs/root_path"}, "path": {"$ref": "#/$defs/path"}}
    },
    "local_extend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "config_path", "extends"],
      "properties": {
        "project_root": {"$ref": "#/$defs/root_path"},
        "config_path": {"$ref": "#/$defs/path"},
        "extends": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "file_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "path", "roles", "effective_role"],
      "properties": {
        "project_root": {"$ref": "#/$defs/root_path"},
        "path": {"$ref": "#/$defs/path"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["control", "context", "program"]}},
        "effective_role": {"enum": ["control", "context", "program"]}
      }
    },
    "config_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "config_path", "declaring_paths", "membership", "path_resolution_order"],
      "properties": {
        "project_root": {"$ref": "#/$defs/root_path"},
        "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "declaring_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "path"],
            "properties": {"option": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}}
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "patterns", "exclude"],
          "properties": {
            "kind": {"enum": ["files", "include", "default", "not_applicable"]},
            "patterns": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/config_pattern"}},
            "exclude": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/config_pattern"}}
          }
        },
        "path_resolution_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "config_pattern": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
    "source_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "open_edges", "graph_digest"],
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/source_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/resolved_edge"}},
        "open_edges": {"type": "array", "items": {"$ref": "#/$defs/open_edge"}},
        "graph_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "project_root", "content_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/digest"},
        "path": {"$ref": "#/$defs/path"},
        "project_root": {"$ref": "#/$defs/root_path"},
        "content_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "resolved_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target", "syntax_kind", "role", "normalized_specifier", "specifier_identity"],
      "properties": {
        "kind": {"const": "resolved"},
        "source": {"$ref": "#/$defs/digest"},
        "target": {"$ref": "#/$defs/digest"},
        "syntax_kind": {"enum": ["static_import", "import_type", "literal_dynamic_import", "export_from", "export_type", "export_type_query", "require", "config_extends"]},
        "role": {"enum": ["value", "type", "control"]},
        "normalized_specifier": {"$ref": "#/$defs/path"},
        "specifier_identity": {"$ref": "#/$defs/digest"},
        "source_span": {"$ref": "#/$defs/byte_span"}
      }
    },
    "open_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "syntax_kind", "reason", "safe_frontier"],
      "properties": {
        "kind": {"const": "open"},
        "source": {"$ref": "#/$defs/digest"},
        "syntax_kind": {"enum": ["source_decode", "module_plane", "static_import", "import_type", "literal_dynamic_import", "export_from", "export_type", "export_type_query", "require", "config_extends"]},
        "reason": {"enum": ["invalid_utf8", "unsupported", "unresolved", "ambiguous"]},
        "target_kind": {"enum": ["external_package", "unresolved_relative"]},
        "source_span": {"$ref": "#/$defs/byte_span"},
        "safe_frontier": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "normalized_specifier"],
              "properties": {
                "source": {"$ref": "#/$defs/digest"},
                "normalized_specifier": {"$ref": "#/$defs/path"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "safe_specifier"],
              "properties": {
                "source": {"$ref": "#/$defs/digest"},
                "safe_specifier": {"type": "string", "pattern": "^(@[a-z0-9._-]+/)?[a-z0-9._-]+(?:/[a-z0-9._-]+)*$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {"source": {"$ref": "#/$defs/digest"}}
            }
          ]
        },
        "specifier_identity": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "required": ["target_kind"],
            "properties": {"target_kind": {"const": "external_package"}}
          },
          "then": {
            "properties": {
              "safe_frontier": {
                "type": "object",
                "required": ["safe_specifier"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["target_kind"],
            "properties": {"target_kind": {"const": "unresolved_relative"}}
          },
          "then": {
            "properties": {
              "safe_frontier": {
                "type": "object",
                "required": ["normalized_specifier"]
              }
            }
          }
        }
      ]
    },
    "byte_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_start", "byte_end"],
      "properties": {
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 1}
      },
      "allOf": [{"if": {"required": ["byte_start", "byte_end"]}, "then": {"properties": {"byte_end": {"exclusiveMinimum": 0}}}}]
    }
  }
}
