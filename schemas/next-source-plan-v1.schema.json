{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-source-plan-v1",
  "title": "CodeStructureViz closed Next SourceAcquisitionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "projects",
    "resolved_control_paths",
    "local_extends",
    "file_role_map",
    "program_suffixes",
    "context_suffixes",
    "hard_exclusions",
    "limits",
    "trusted_environment_digest"
  ],
  "properties": {
    "schema": {"const": "code-structure-viz.source-acquisition-plan/next/v1"},
    "version": {"const": "1"},
    "projects": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/project"}},
    "resolved_control_paths": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/control_path"}},
    "local_extends": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/local_extend"}},
    "file_role_map": {"type": "array", "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/file_role"}},
    "program_suffixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
    "context_suffixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9.]+$"}},
    "hard_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f]).+$"}},
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"},
    "trusted_environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"$ref": "urn:code-structure-viz:schema:next-path-v1"},
    "root_path": {"$ref": "urn:code-structure-viz:schema:next-root-or-path-v1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "source_roots", "config_path", "compiler_options"],
      "properties": {
        "root": {"$ref": "#/$defs/root_path"},
        "source_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:code-structure-viz:schema:next-root-or-path-v1"}},
        "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "compiler_options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_js", "check_js", "jsx", "module", "module_resolution", "base_url", "paths"],
          "properties": {
            "allow_js": {"type": "boolean"},
            "check_js": {"type": "boolean"},
            "jsx": {"enum": ["preserve", "react", "react-jsx", "react-jsxdev"]},
            "module": {"const": "esnext"},
            "module_resolution": {"const": "bundler"},
            "base_url": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
            "paths": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Za-z0-9_.*?/-]+$": {"type": "array", "items": {"$ref": "#/$defs/path"}}}}
          }
        }
      }
    },
    "control_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "path"],
      "properties": {"project_root": {"$ref": "#/$defs/root_path"}, "path": {"$ref": "#/$defs/path"}}
    },
    "local_extend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "config_path", "extends"],
      "properties": {
        "project_root": {"$ref": "#/$defs/root_path"},
        "config_path": {"$ref": "#/$defs/path"},
        "extends": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "file_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "path", "roles", "effective_role"],
      "properties": {
        "project_root": {"$ref": "#/$defs/root_path"},
        "path": {"$ref": "#/$defs/path"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["control", "context", "program"]}},
        "effective_role": {"enum": ["control", "context", "program"]}
      }
    }
  }
}
