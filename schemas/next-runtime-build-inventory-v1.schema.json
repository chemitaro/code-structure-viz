{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-runtime-build-inventory-v1",
  "title": "CodeStructureViz shipped Next runtime build inventory v1",
  "description": "Future package-build inventory for adapter, TypeScript, trusted declarations, and license members. This schema is independent from run-state manifests and has no checked-in production package claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inventory_version", "build_input_digest", "build_output_digest", "license_inventory_digest", "members", "licenses", "inventory_attestation"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-runtime-build-inventory/v1"},
    "inventory_version": {"type": "integer", "const": 1},
    "build_input_digest": {"$ref": "#/$defs/digest"},
    "build_output_digest": {"$ref": "#/$defs/digest"},
    "license_inventory_digest": {"$ref": "#/$defs/digest"},
    "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
    "licenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/license"}},
    "inventory_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "inventory_version", "members", "sha256"],
      "properties": {
        "schema": {"const": "code-structure-viz.next-runtime-build-inventory/v1"},
        "inventory_version": {"const": 1},
        "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_path", "package_path", "size_bytes", "sha256", "role"],
      "allOf": [
        {"if": {"properties": {"source_kind": {"const": "adapter"}}}, "then": {"properties": {"role": {"const": "adapter"}}}},
        {"if": {"properties": {"source_kind": {"const": "typescript"}}}, "then": {"properties": {"role": {"const": "typescript_lib"}}}},
        {"if": {"properties": {"source_kind": {"const": "trusted_declaration"}}}, "then": {"properties": {"role": {"const": "trusted_declaration"}}}},
        {"if": {"properties": {"source_kind": {"const": "license"}}}, "then": {"properties": {"role": {"const": "license"}}}}
      ],
      "properties": {
        "source_kind": {"enum": ["adapter", "typescript", "trusted_declaration", "license"]},
        "source_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
        "package_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "role": {"enum": ["adapter", "typescript_lib", "trusted_declaration", "license"]}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "license_id", "source_url", "content_or_lock_digest"],
      "properties": {
        "ecosystem": {"enum": ["npm", "resource"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license_id": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
        "content_or_lock_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
