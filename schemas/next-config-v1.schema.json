{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-config-v1",
  "title": "CodeStructureViz resolved Next domain config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projects", "targets", "upstream_depth", "downstream_depth", "limits", "trusted_environment_digest"],
  "properties": {
    "schema": {"const": "code-structure-viz.domain-config/next/v1"},
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/project"}},
    "targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "upstream_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "downstream_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "limits": {"$ref": "#/$defs/limits"},
    "trusted_environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "compiler_options": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_js", "check_js", "jsx", "module", "module_resolution", "base_url", "paths"],
      "properties": {
        "allow_js": {"type": "boolean"}, "check_js": {"type": "boolean"},
        "jsx": {"enum": ["preserve", "react", "react-jsx", "react-jsxdev"]},
        "module": {"const": "esnext"}, "module_resolution": {"const": "bundler"},
        "base_url": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "paths": {"type": "object", "patternProperties": {"^[A-Za-z0-9_.*?/-]+$": {"type": "array", "items": {"$ref": "#/$defs/path"}}}, "additionalProperties": false}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "source_roots", "config_path", "compiler_options"],
      "properties": {"root": {"$ref": "#/$defs/path"}, "source_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "compiler_options": {"$ref": "#/$defs/compiler_options"}}
    },
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"}
  }
}
