{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-config-v1",
  "title": "CodeStructureViz resolved Next domain config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projects", "targets", "upstream_depth", "downstream_depth", "limits", "trusted_environment_digest"],
  "properties": {
    "schema": {"const": "code-structure-viz.domain-config/next/v1"},
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/project"}},
    "targets": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "upstream_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "downstream_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "limits": {"$ref": "#/$defs/limits"},
    "trusted_environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "source_roots", "config_path"],
      "properties": {"root": {"$ref": "#/$defs/path"}, "source_roots": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_entities", "max_files", "max_file_bytes", "max_decoded_bytes", "max_model_records", "max_type_depth", "max_type_nodes_per_prop", "max_flow_visits", "max_alias_edges"],
      "properties": {
        "max_entities": {"type": "integer", "minimum": 1, "default": 500},
        "max_files": {"type": "integer", "minimum": 1, "default": 20000},
        "max_file_bytes": {"type": "integer", "minimum": 1, "default": 4194304},
        "max_decoded_bytes": {"type": "integer", "minimum": 1, "default": 67108864},
        "max_model_records": {"type": "integer", "minimum": 1, "default": 100000},
        "max_type_depth": {"type": "integer", "minimum": 1, "default": 16},
        "max_type_nodes_per_prop": {"type": "integer", "minimum": 1, "default": 512},
        "max_flow_visits": {"type": "integer", "minimum": 1, "default": 10000},
        "max_alias_edges": {"type": "integer", "minimum": 1, "default": 64}
      }
    }
  }
}
