{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-adapter-request-v2",
  "title": "CodeStructureViz source-sealed Next adapter request v2",
  "description": "Parent-generated source/analysis intent, without candidate or actual runtime identity. Retained source/assets, canonical bytes and limit joins require the owner validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol", "request_id", "adapter_version", "trusted_type_environment", "runtime_requirement", "projects", "files", "targets", "limits", "run_context"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-adapter-request/v2"},
    "protocol": {"const": "code-structure-viz.next-adapter/v2"},
    "request_id": {"$ref": "urn:code-structure-viz:schema:next-execution-assets-v1#/$defs/digest"},
    "adapter_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"},
    "trusted_type_environment": {"$ref": "urn:code-structure-viz:schema:next-trusted-type-environment-v2#/$defs/descriptor"},
    "runtime_requirement": {"$ref": "urn:code-structure-viz:schema:next-node-runtime-requirement-v1"},
    "projects": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "urn:code-structure-viz:schema:next-adapter-request-v1#/$defs/project"}},
    "files": {"type": "array", "maxItems": 20000, "items": {"$ref": "urn:code-structure-viz:schema:next-adapter-request-v1#/$defs/file"}},
    "targets": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "urn:code-structure-viz:schema:next-config-v1#/$defs/target_key"}},
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"},
    "run_context": {"$ref": "urn:code-structure-viz:schema:next-run-context-v1"}
  }
}
