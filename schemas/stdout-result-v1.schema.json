{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeStructureViz unavailable stdout result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "selector",
    "availability",
    "stable_reason",
    "artifact"
  ],
  "properties": {
    "type": {"const": "stdout_result"},
    "schema": {"const": "code-structure-viz.stdout-result/v1"},
    "selector": {
      "enum": [
        "manifest",
        "python:semantic-json",
        "python:plantuml",
        "sqlalchemy:semantic-json",
        "sqlalchemy:plantuml"
      ]
    },
    "availability": {"const": false},
    "domain_status": {"enum": ["not_applicable", "incomplete"]},
    "run_status": {"enum": ["fatal", "interrupted"]},
    "stable_reason": {
      "enum": [
        "domain_not_applicable",
        "domain_payload_unavailable",
        "run_fatal",
        "final_manifest_unavailable",
        "run_interrupted"
      ]
    },
    "artifact": {"type": "null"}
  },
  "oneOf": [
    {
      "required": ["domain_status"],
      "not": {"required": ["run_status"]},
      "properties": {
        "selector": {
          "enum": [
            "python:semantic-json",
            "python:plantuml",
            "sqlalchemy:semantic-json",
            "sqlalchemy:plantuml"
          ]
        },
        "domain_status": {"const": "not_applicable"},
        "stable_reason": {"const": "domain_not_applicable"}
      }
    },
    {
      "required": ["domain_status"],
      "not": {"required": ["run_status"]},
      "properties": {
        "selector": {
          "enum": [
            "python:semantic-json",
            "python:plantuml",
            "sqlalchemy:semantic-json",
            "sqlalchemy:plantuml"
          ]
        },
        "domain_status": {"const": "incomplete"},
        "stable_reason": {"const": "domain_payload_unavailable"}
      }
    },
    {
      "required": ["run_status"],
      "not": {"required": ["domain_status"]},
      "properties": {
        "selector": {
          "enum": [
            "python:semantic-json",
            "python:plantuml",
            "sqlalchemy:semantic-json",
            "sqlalchemy:plantuml"
          ]
        },
        "run_status": {"const": "fatal"},
        "stable_reason": {"const": "run_fatal"}
      }
    },
    {
      "required": ["run_status"],
      "not": {"required": ["domain_status"]},
      "properties": {
        "selector": {"const": "manifest"},
        "run_status": {"const": "fatal"},
        "stable_reason": {"const": "final_manifest_unavailable"}
      }
    },
    {
      "required": ["run_status"],
      "not": {"required": ["domain_status"]},
      "properties": {
        "run_status": {"const": "interrupted"},
        "stable_reason": {"const": "run_interrupted"}
      }
    }
  ]
}
