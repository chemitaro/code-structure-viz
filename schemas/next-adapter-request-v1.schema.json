{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-adapter-request-v1",
  "title": "CodeStructureViz Next adapter request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol", "request_id", "adapter_version", "trusted_type_environment", "projects", "files", "targets", "limits"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-adapter-request/v1"},
    "protocol": {"const": "code-structure-viz.next-adapter/v1"},
    "request_id": {"$ref": "#/$defs/digest"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trusted_type_environment": {"$ref": "#/$defs/trusted"},
    "projects": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/project"}},
    "files": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/file"}},
    "targets": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "urn:code-structure-viz:schema:next-config-v1#/$defs/target_key"}},
    "limits": {"$ref": "urn:code-structure-viz:schema:next-limits-v1"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "trusted": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "environment_version", "semantic_profile_id", "sha256"],
      "properties": {
        "schema": {"const": "code-structure-viz.next-trusted-types/v1"},
        "environment_version": {"type": "string", "minLength": 1},
        "semantic_profile_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "compiler_options": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_js", "check_js", "jsx", "module", "module_resolution", "base_url", "paths"],
      "properties": {
        "allow_js": {"type": "boolean"}, "check_js": {"type": "boolean"},
        "jsx": {"enum": ["preserve", "react", "react-jsx", "react-jsxdev"]},
        "module": {"const": "esnext"}, "module_resolution": {"const": "bundler"},
        "base_url": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "paths": {"type": "object", "patternProperties": {"^[A-Za-z0-9_.*?/-]+$": {"type": "array", "items": {"$ref": "#/$defs/path"}}}, "additionalProperties": false}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "root", "source_roots", "config_path", "config_digest", "compiler_options", "file_ids"],
      "properties": {
        "kind": {"const": "project"},
        "id": {"type": "string", "pattern": "^next:project:[0-9a-f]{64}$"},
        "root": {"$ref": "#/$defs/path"},
        "source_roots": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "config_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "config_digest": {"$ref": "#/$defs/digest"},
        "compiler_options": {"$ref": "#/$defs/compiler_options"},
        "file_ids": {"type": "array", "maxItems": 20000, "items": {"type": "string", "pattern": "^next:file:[0-9a-f]{64}$"}}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "path", "project_id", "roles", "effective_role", "size_bytes", "sha256", "content_base64"],
      "properties": {
        "kind": {"const": "file"},
        "id": {"type": "string", "pattern": "^next:file:[0-9a-f]{64}$"},
        "path": {"$ref": "#/$defs/path"},
        "project_id": {"type": "string", "pattern": "^next:project:[0-9a-f]{64}$"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["control", "context", "program"]}},
        "effective_role": {"enum": ["control", "context", "program"]},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "sha256": {"$ref": "#/$defs/digest"},
        "content_base64": {"type": "string", "maxLength": 5592408, "contentEncoding": "base64"}
      }
    }
  }
}
