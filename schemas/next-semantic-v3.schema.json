{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-semantic-v3",
  "title": "CodeStructureViz Next semantic document v3 source-inventory contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "domain",
    "document_kind",
    "status",
    "semantic_compatibility_id",
    "compatibility_descriptor",
    "identity_versions",
    "source",
    "request",
    "coverage",
    "projects",
    "files",
    "entities",
    "members",
    "relations",
    "facts",
    "diagnostics",
    "source_inventory_summary"
  ],
  "properties": {
    "type": {
      "const": "semantic_snapshot"
    },
    "schema": {
      "const": "code-structure-viz.semantic/v3"
    },
    "domain": {
      "const": "next"
    },
    "document_kind": {
      "const": "snapshot"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "incomplete_kind": {
      "const": "partial_safe"
    },
    "semantic_compatibility_id": {
      "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/digest"
    },
    "compatibility_descriptor": {
      "$ref": "urn:code-structure-viz:schema:next-compatibility-v3"
    },
    "identity_versions": {
      "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/identity_versions"
    },
    "source": {
      "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/source"
    },
    "request": {
      "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/request"
    },
    "coverage": {
      "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/coverage"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/project"
      }
    },
    "files": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/file"
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/component"
          }
        ]
      }
    },
    "members": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/export_member"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/import_member"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/prop_member"
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/module_relation"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/render_relation"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/wrap_relation"
          }
        ]
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/client_fact"
          },
          {
            "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/router_fact"
          }
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/diagnostic"
      }
    },
    "source_inventory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "source_partition_fingerprint",
        "acquired",
        "safe",
        "proof_only",
        "records",
        "published_entities"
      ],
      "properties": {
        "profile_id": {
          "const": "next-source-inventory-safe-subset-v1"
        },
        "source_partition_fingerprint": {
          "$ref": "urn:code-structure-viz:schema:next-semantic-v1#/$defs/digest"
        },
        "acquired": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projects",
            "files",
            "file_bytes"
          ],
          "properties": {
            "projects": {
              "$ref": "#/$defs/count"
            },
            "files": {
              "$ref": "#/$defs/count"
            },
            "file_bytes": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "safe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projects",
            "files"
          ],
          "properties": {
            "projects": {
              "$ref": "#/$defs/count"
            },
            "files": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "proof_only": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failed_files",
            "excluded_files"
          ],
          "properties": {
            "failed_files": {
              "$ref": "#/$defs/count"
            },
            "excluded_files": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proof_discovered",
            "published",
            "proof_only",
            "accounted"
          ],
          "properties": {
            "proof_discovered": {
              "$ref": "#/$defs/count"
            },
            "published": {
              "$ref": "#/$defs/count"
            },
            "proof_only": {
              "$ref": "#/$defs/count"
            },
            "accounted": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "published_entities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modules",
            "components",
            "total"
          ],
          "properties": {
            "modules": {
              "$ref": "#/$defs/count"
            },
            "components": {
              "$ref": "#/$defs/count"
            },
            "total": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "required": [
          "incomplete_kind"
        ]
      },
      "else": {
        "not": {
          "required": [
            "incomplete_kind"
          ]
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
