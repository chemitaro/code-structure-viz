{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeStructureViz run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema",
    "tool",
    "contracts",
    "adapters",
    "command",
    "request",
    "config",
    "run",
    "domains",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "type": {"const": "run_manifest"},
    "schema": {"const": "code-structure-viz.run-manifest/v1"},
    "tool": {"$ref": "#/$defs/tool"},
    "contracts": {"$ref": "#/$defs/contracts"},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    },
    "command": {"$ref": "#/$defs/command"},
    "request": {"$ref": "#/$defs/request"},
    "source": {"$ref": "#/$defs/source"},
    "comparison": {"$ref": "#/$defs/comparison"},
    "sources": {"$ref": "#/$defs/sources"},
    "semantic_sides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/semantic_side"},
        "after": {"$ref": "#/$defs/semantic_side"}
      }
    },
    "file_change_set": {"$ref": "#/$defs/file_change_set"},
    "changed_path_budget": {"$ref": "#/$defs/changed_path_budget"},
    "config": {"$ref": "#/$defs/config"},
    "run": {"$ref": "#/$defs/run"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/domain"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "oneOf": [
    {
      "properties": {
        "run": {
          "properties": {
            "status": {"const": "complete"},
            "exit_code": {"const": 0}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "complete"},
                "payload_available": {"const": true},
                "artifact_paths": {"minItems": 1}
              }
            }
          ]
        },
        "artifacts": {"minItems": 1}
      }
    },
    {
      "properties": {
        "run": {
          "properties": {
            "status": {"const": "not_applicable"},
            "exit_code": {"const": 0}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "not_applicable"},
                "payload_available": {"const": false},
                "artifact_paths": {"maxItems": 0}
              }
            }
          ]
        },
        "artifacts": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "run": {
          "properties": {
            "status": {"const": "incomplete"},
            "exit_code": {"const": 3}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "incomplete"},
                "incomplete_kind": {"const": "partial_safe"},
                "payload_available": {"const": true},
                "artifact_paths": {"minItems": 1}
              }
            }
          ]
        },
        "artifacts": {"minItems": 1}
      }
    },
    {
      "properties": {
        "run": {
          "properties": {
            "status": {"const": "incomplete"},
            "exit_code": {"const": 3}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "incomplete"},
                "incomplete_kind": {"const": "payload_unavailable"},
                "payload_available": {"const": false},
                "artifact_paths": {"maxItems": 0}
              }
            }
          ]
        },
        "artifacts": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "command": {"properties": {"name": {"const": "diff"}}},
        "run": {
          "properties": {
            "status": {"const": "incomplete"},
            "exit_code": {"const": 3}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "incomplete"},
                "incomplete_kind": {"const": "payload_unavailable"},
                "payload_available": {"const": false},
                "artifact_paths": {"maxItems": 0}
              }
            }
          ]
        },
        "artifacts": {
          "minItems": 1,
          "maxItems": 1,
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"const": "file-changes.json"}}
          }
        }
      }
    },
    {
      "properties": {
        "command": {"properties": {"name": {"const": "diff"}}},
        "run": {
          "properties": {
            "status": {"const": "not_applicable"},
            "exit_code": {"const": 0}
          }
        },
        "domains": {
          "prefixItems": [
            {
              "properties": {
                "status": {"const": "not_applicable"},
                "payload_available": {"const": false},
                "artifact_paths": {"maxItems": 0}
              }
            }
          ]
        },
        "artifacts": {"minItems": 1}
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"command": {"properties": {"name": {"const": "snapshot"}}}}},
      "then": {"required": ["source"]}
    },
    {
      "if": {"properties": {"command": {"properties": {"name": {"const": "diff"}}}}},
      "then": {
        "required": ["comparison", "sources", "semantic_sides", "file_change_set", "changed_path_budget"]
      }
    },
    {
      "if": {
        "properties": {
          "command": {"properties": {"domain": {"const": "python"}}}
        }
      },
      "then": {
        "properties": {
          "contracts": {
            "properties": {
              "plantuml": {"const": "code-structure-viz.plantuml/python/v1"}
            }
          },
          "adapters": {
            "prefixItems": [
              {
                "properties": {
                  "domain": {"const": "python"},
                  "name": {"const": "python-ast"}
                }
              }
            ]
          },
          "domains": {
            "prefixItems": [
              {"properties": {"domain": {"const": "python"}}}
            ]
          },
          "artifacts": {
            "items": {"properties": {"domain": {"const": "python"}}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {"properties": {"domain": {"const": "sqlalchemy"}}}
        }
      },
      "then": {
        "properties": {
          "contracts": {
            "properties": {
              "plantuml": {"const": "code-structure-viz.plantuml/sqlalchemy/v2"}
            }
          },
          "adapters": {
            "prefixItems": [
              {
                "properties": {
                  "domain": {"const": "sqlalchemy"},
                  "name": {"const": "sqlalchemy-ast"}
                }
              }
            ]
          },
          "domains": {
            "prefixItems": [
              {"properties": {"domain": {"const": "sqlalchemy"}}}
            ]
          },
          "artifacts": {
            "items": {"properties": {"domain": {"const": "sqlalchemy"}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "code-structure-viz"},
        "version": {"const": "0.1.0.dev0"}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "diagnostic",
        "source_view",
        "semantic",
        "manifest",
        "run_summary",
        "stdout_result",
        "plantuml"
      ],
      "properties": {
        "config": {"const": "code-structure-viz.config/v1"},
        "diagnostic": {"const": "code-structure-viz.diagnostic/v1"},
        "source_view": {"const": "code-structure-viz.source-view/v1"},
        "semantic": {"const": "code-structure-viz.semantic/v1"},
        "manifest": {"const": "code-structure-viz.run-manifest/v1"},
        "run_summary": {"const": "code-structure-viz.run-summary/v1"},
        "stdout_result": {"const": "code-structure-viz.stdout-result/v1"},
        "plantuml": {
          "enum": [
            "code-structure-viz.plantuml/python/v1",
            "code-structure-viz.plantuml/sqlalchemy/v2"
          ]
        },
        "file_change_set": {"const": "code-structure-viz.file-change-set/v1"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "name", "version"],
      "properties": {
        "domain": {"enum": ["python", "sqlalchemy"]},
        "name": {"enum": ["python-ast", "sqlalchemy-ast"]},
        "version": {"const": "1"}
      },
      "oneOf": [
        {
          "properties": {
            "domain": {"const": "python"},
            "name": {"const": "python-ast"}
          }
        },
        {
          "properties": {
            "domain": {"const": "sqlalchemy"},
            "name": {"const": "sqlalchemy-ast"}
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "formats", "stdout_selector"],
      "properties": {
        "name": {"enum": ["snapshot", "diff"]},
        "domain": {"enum": ["python", "sqlalchemy"]},
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["semantic-json", "plantuml"]}
        },
        "stdout_selector": {
          "enum": [
            null,
            "manifest",
            "python:semantic-json",
            "python:plantuml",
            "sqlalchemy:semantic-json",
            "sqlalchemy:plantuml"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "domain": {"const": "python"},
            "stdout_selector": {
              "enum": [null, "manifest", "python:semantic-json", "python:plantuml"]
            }
          }
        },
        {
          "properties": {
            "name": {"const": "snapshot"},
            "domain": {"const": "sqlalchemy"},
            "stdout_selector": {
              "enum": [
                null,
                "manifest",
                "sqlalchemy:semantic-json",
                "sqlalchemy:plantuml"
              ]
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["path", "module", "class"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "from": {"type": ["string", "null"], "minLength": 1},
        "to": {"type": ["string", "null"], "minLength": 1},
        "pr_target": {"type": ["string", "null"], "minLength": 1},
        "upstream_depth": {"type": "integer", "minimum": 0},
        "downstream_depth": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {
          "required": ["targets", "upstream_depth", "downstream_depth"],
          "not": {"required": ["from", "to", "pr_target"]}
        },
        {
          "required": ["from", "to", "pr_target", "upstream_depth", "downstream_depth"]
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "head_commit", "fingerprint", "file_count"],
      "properties": {
        "schema": {"const": "code-structure-viz.source-view/v1"},
        "kind": {"enum": ["working-tree", "commit", "frozen-working-tree"]},
        "head_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 0}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/source"},
        "after": {"$ref": "#/$defs/source"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "resolved",
        "before_kind",
        "after_kind",
        "start_head_anchor",
        "selected_base_candidate",
        "merge_base",
        "resolution_method",
        "candidate_observations"
      ],
      "properties": {
        "requested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {"type": ["string", "null"], "minLength": 1},
            "to": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "after": {
              "oneOf": [
                {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
                {"type": "null"}
              ]
            }
          }
        },
        "before_kind": {"const": "commit"},
        "after_kind": {"enum": ["commit", "frozen-working-tree"]},
        "start_head_anchor": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "selected_base_candidate": {"type": ["string", "null"], "minLength": 1},
        "merge_base": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "resolution_method": {"type": "string", "minLength": 1},
        "candidate_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_observation"}
        }
      }
    },
    "candidate_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "origin",
        "reference",
        "resolved_object",
        "merge_base",
        "disposition"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "origin": {"enum": ["pr-target", "config-target", "config-upstream", "builtin"]},
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*://)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"
        },
        "resolved_object": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "merge_base": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "disposition": {
          "enum": ["unresolved", "no-merge-base", "selected", "not-evaluated"]
        }
      }
    },
    "semantic_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain", "schema", "digest", "head_commit", "file_count"],
      "properties": {
        "kind": {"enum": ["real", "canonical-empty-side", "analysis-failed"]},
        "domain": {"const": "python"},
        "schema": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "head_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "file_count": {"type": "integer", "minimum": 0}
      }
    },
    "file_change_hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_start",
        "old_line_count",
        "new_start",
        "new_line_count",
        "ordinal",
        "hunk_id"
      ],
      "properties": {
        "old_start": {"type": "integer", "minimum": 0},
        "old_line_count": {"type": "integer", "minimum": 0},
        "new_start": {"type": "integer", "minimum": 0},
        "new_line_count": {"type": "integer", "minimum": 0},
        "ordinal": {"type": "integer", "minimum": 0},
        "hunk_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "file_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "old_path", "new_path", "hunks"],
      "properties": {
        "status": {"enum": ["A", "M", "D", "R", "C", "T", "U", "?"]},
        "old_path": {"type": ["string", "null"], "minLength": 1},
        "new_path": {"type": ["string", "null"], "minLength": 1},
        "hunks": {"type": "array", "items": {"$ref": "#/$defs/file_change_hunk"}}
      }
    },
    "file_change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "before", "after", "files"],
      "properties": {
        "schema": {"const": "code-structure-viz.file-change-set/v1"},
        "before": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "after": {
          "oneOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "files": {"type": "array", "items": {"$ref": "#/$defs/file_change"}}
      }
    },
    "changed_path_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requested", "resolved", "actual", "source"],
      "properties": {
        "name": {"const": "max_changed_paths"},
        "requested": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "resolved": {"type": "integer", "minimum": 1},
        "actual": {"type": "integer", "minimum": 0},
        "source": {"enum": ["builtin", "repository", "explicit", "cli"]}
      }
    },
    "resolved_python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roots", "include", "exclude"],
      "properties": {
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "resolved_traversal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_depth", "downstream_depth"],
      "properties": {
        "upstream_depth": {"type": "integer", "minimum": 0},
        "downstream_depth": {"type": "integer", "minimum": 0}
      }
    },
    "resolved_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_entities"],
      "properties": {"max_entities": {"type": "integer", "minimum": 1}}
    },
    "resolved_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "upstream_ref"],
      "properties": {
        "target_ref": {"type": ["string", "null"], "minLength": 1},
        "upstream_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "traversal", "limits"],
      "properties": {
        "python": {"$ref": "#/$defs/resolved_python"},
        "traversal": {"$ref": "#/$defs/resolved_traversal"},
        "limits": {"$ref": "#/$defs/resolved_limits"},
        "comparison": {"$ref": "#/$defs/resolved_comparison"}
      }
    },
    "value_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_source_roots",
        "python_include",
        "python_exclude",
        "upstream_depth",
        "downstream_depth",
        "max_entities"
      ],
      "properties": {
        "python_source_roots": {"enum": ["builtin", "repository", "explicit"]},
        "python_include": {"enum": ["builtin", "repository", "explicit"]},
        "python_exclude": {"enum": ["builtin", "repository", "explicit"]},
        "upstream_depth": {"enum": ["builtin", "repository", "explicit", "cli"]},
        "downstream_depth": {"enum": ["builtin", "repository", "explicit", "cli"]},
        "max_entities": {"enum": ["builtin", "repository", "explicit", "cli"]}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "sha256", "resolved", "value_sources"],
      "properties": {
        "schema": {"const": "code-structure-viz.config/v1"},
        "source": {"enum": ["builtin", "repository", "explicit"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolved": {"$ref": "#/$defs/resolved"},
        "value_sources": {"$ref": "#/$defs/value_sources"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "fingerprint"],
      "properties": {
        "status": {"enum": ["complete", "not_applicable", "incomplete"]},
        "exit_code": {"enum": [0, 3]},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"enum": ["complete", "not_applicable"]},
            "exit_code": {"const": 0}
          }
        },
        {
          "properties": {
            "status": {"const": "incomplete"},
            "exit_code": {"const": 3}
          }
        }
      ]
    },
    "failed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "stage", "diagnostic_code"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "stage": {
          "enum": [
            "read",
            "path_safety",
            "encoding",
            "parse",
            "module_identity",
            "module_collision"
          ]
        },
        "diagnostic_code": {
          "enum": [
            "CSV-SOURCE-002",
            "CSV-SOURCE-004",
            "CSV-PY-001",
            "CSV-PY-002",
            "CSV-PY-003",
            "CSV-PY-004",
            "CSV-PY-005"
          ]
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "kind", "reference", "reason"],
      "properties": {
        "direction": {"enum": ["upstream", "downstream", "failure"]},
        "kind": {"enum": ["module", "class", "symbol", "file"]},
        "reference": {"type": "string", "minLength": 1},
        "reason": {
          "enum": [
            "depth_limit",
            "unresolved_reference",
            "failed_source",
            "unsupported_scope",
