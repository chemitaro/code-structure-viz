{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-structure-viz:schema:next-reference-runtime-inventory-v1",
  "title": "CodeStructureViz checked-in Next reference runtime inventory v1",
  "description": "The exact four-member inventory used only by the checked-in reference lane. It is not run provenance or a shipped package manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "build_input_digest", "build_output_digest", "license_inventory_digest", "manifest_sha256", "members", "licenses", "inventory_attestation"],
  "properties": {
    "schema": {"const": "code-structure-viz.next-reference-runtime-inventory/v1"},
    "build_input_digest": {"$ref": "#/$defs/digest"},
    "build_output_digest": {"$ref": "#/$defs/digest"},
    "license_inventory_digest": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "members": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "adapter"}}}},
        {"contains": {"properties": {"role": {"const": "typescript_lib"}}}},
        {"contains": {"properties": {"role": {"const": "trusted_declaration"}}}},
        {"contains": {"properties": {"role": {"const": "manifest"}}}}
      ]
    },
    "licenses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/license"}
    },
    "inventory_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "members", "sha256"],
      "properties": {
        "schema": {"const": "code-structure-viz.next-reference-runtime-inventory/v1"},
        "members": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_path", "path", "size_bytes", "sha256", "role"],
      "properties": {
        "physical_path": {"type": "string", "pattern": "^tests/fixtures/next_runtime/[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])src/code_structure_viz/_next_runtime/[A-Za-z0-9._/-]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "role": {"enum": ["adapter", "typescript_lib", "trusted_declaration", "manifest"]}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "license_id", "source_url", "content_or_lock_digest"],
      "properties": {
        "ecosystem": {"enum": ["npm", "resource"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license_id": {"enum": ["MIT", "Apache-2.0"]},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
        "content_or_lock_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
